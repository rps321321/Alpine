{
  "schema": 4,
  "lifecycle": ["experimental", "candidate", "validated", "production"],
  "gates": {
    "candidate": {
      "required_workloads": ["prefill-4k", "novel-256", "repeat-code-256", "structured-json-128"],
      "minimum_measured_samples_per_workload": 5,
      "require_quality_pass": true,
      "require_deterministic_outputs": true,
      "performance_metric_by_workload": {
        "prefill-4k": "prefill-tps",
        "novel-256": "decode-tps",
        "repeat-code-256": "decode-tps",
        "structured-json-128": "decode-tps"
      },
      "general_score_workloads": ["prefill-4k", "novel-256", "structured-json-128"],
      "repeated_specialization_workloads": ["repeat-code-256"],
      "maximum_performance_coefficient_of_variation": 0.10,
      "maximum_median_performance_regression_fraction": 0.10,
      "minimum_tuning_selection_improvement_fraction": 0.03
    },
    "validated": {
      "inherits": "candidate",
      "golden_evidence": {
        "task_id": "public-v1",
        "required_capabilities": [
          "multi-file-tdd-repair",
          "tool-error-recovery",
          "constraint-retention"
        ]
      },
      "requires_external_evidence": [
        "same-process-50-request-greedy-stability",
        "ten-clean-restart-greedy-stability",
        "near-limit-context-stress",
        "golden-agent-task-pass"
      ]
    },
    "production": {
      "inherits": "validated",
      "requires_external_evidence": [
        "operator-reviewed-capability-report",
        "rollback-profile-available"
      ]
    }
  }
}
